# ============================================================
# Cloud deployment environment (演示最小集)
# Usage: cp cloud.env.example cloud.env && vim cloud.env
# Then:  source cloud.env && ./start-all.sh
#
# RULES:
#   1. Spring Boot does NOT read this file — it is sourced into the shell
#      by start-all.sh. Every variable referenced as ${VAR:default} in
#      application.yml must be exported here.
#   2. No quotes around values that contain '=' or '&'? Quote the whole
#      value instead, e.g. DB_URL="jdbc:mysql://...?a=1&b=2".
#   3. NEVER commit cloud.env (it holds the real API key).
# ============================================================

# ---- App root on the cloud host (absolute path!) ----
export APP_ROOT=/opt/ecommerce/TraslationSystem

# ---- Java / Python ----
export JAVA_BIN=java
export PY_BIN=python3

# ---- MySQL (now LOCAL on the cloud host, imported from dump) ----
export DB_URL="jdbc:mysql://localhost:3306/ecommerce?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai"
export DB_USERNAME=ecommerce_app
export DB_PASSWORD="CHANGE_ME_DB_PASSWORD"

# ---- Elasticsearch: DISABLED for the demo ----
# With ES off, /api/products falls back to MySQL ngram fulltext.
# The ft_product_search index is included in the dump.
export ES_ENABLED=false
export ES_USE_FOR_BROWSE=false
export ES_URL="https://localhost:9200"          # unused when ES_ENABLED=false
export ES_USERNAME=
export ES_PASSWORD=

# ---- Canal: DISABLED (nothing to sync when ES is off) ----
export CANAL_ENABLED=false

# ---- Redis: optional. Set REDIS_ENABLED=false to skip installing Redis ----
# The Java services have circuit-breaker degradation for Redis.
export REDIS_ENABLED=false
export REDIS_HOST=127.0.0.1
export REDIS_PORT=6379
export REDIS_PASSWORD=
export REDIS_DB=1

# ---- JWT: must match between auth-service and gateway ----
export JWT_SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN"
export JWT_EXPIRATION_HOURS=24

# ---- LLM: REQUIRED for translation and AI assistant ----
export LLM_API_KEY="CHANGE_ME_DEEPSEEK_KEY"
export LLM_BASE_URL="https://api.deepseek.com"
export LLM_MODEL_NAME="deepseek-chat"

# ---- Embedding service: optional. Set EMBEDDING_ENABLED=false ----
# to skip the 2.8GB model upload and the Python service.
# Impact: recommendation degrades to content-based + default; RAG assistant unavailable.
export EMBEDDING_ENABLED=false
export EMBEDDING_SERVICE_URL="http://127.0.0.1:10683"
export SBERT_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"
export AI_MODEL_ROOT="$APP_ROOT/huggingface_cache"

# ---- Translation engine: keep false (no local NLLB, no torch load) ----
export USE_LOCAL_MT_MODEL=false

# ---- Service-to-service URLs (all LOCAL on the cloud host) ----
export AUTH_SERVICE_URL="http://localhost:8081"
export CATALOG_SERVICE_URL="http://localhost:8082"
export TRANSLATION_SERVICE_URL="http://localhost:8083"
export RECOMMENDATION_SERVICE_URL="http://localhost:8084"
export PLATFORM_SERVICE_URL="http://localhost:8085"
export GATEWAY_PUBLIC_URL="http://localhost:10682"

# ---- Absolute filesystem paths (relative paths break across CWDs) ----
export UPLOAD_DIR="$APP_ROOT/backend-java/uploads"
export ASSISTANT_FAQ_PATH="$APP_ROOT/data/assistant_faq.json"
export ASSISTANT_INDEX_DIR="$APP_ROOT/assistant-index"

# ---- Ports ----
export GATEWAY_PORT=10682
