# ============================================================
# 本地配置模板 —— 复制为 .env 后填入真实值
#   cp .env.example .env
#
# 注意：Spring Boot 不读这个文件，它供 Python 侧（backend/）使用。
#       Java 服务读的是 backend-java/env.bat（模板见 env.example.bat）。
# ============================================================

# ---- LLM（OpenAI 兼容协议）：deepseek | doubao ----
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-REPLACE_WITH_YOUR_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

PORT=10682
DEBUG=false
SBERT_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# ---- 翻译引擎开关 ----
# false = 全部走第三方大模型，不加载本地 NLLB，不导入 torch（启动快、省内存）
# true  = 恢复「本地 NLLB 翻译 + LLM 优化」两阶段链路（需自备 2.8G 模型）
USE_LOCAL_MT_MODEL=false

# ---- Redis（可选；不启用时依赖熔断降级）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_FAILURE_THRESHOLD=3
REDIS_COOLDOWN_SECONDS=30

# ---- JWT（必须与 backend-java/env.bat 中的值一致，否则全站 401）----
# 生成：openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_32_BYTES_HEX
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---- Elasticsearch（可选；ES_ENABLED=false 时走 MySQL 全文索引）----
# 自签证书实例需把 CA 拷到本地并在此指定路径
ES_HOSTS=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_CA_CERTS=
ES_VERIFY_CERTS=true
ES_REQUEST_TIMEOUT=10

ES_INDEX=product
ES_SHARDS=1
ES_REPLICAS=0

# 搜索后端：mysql | es | auto（auto = ES 可用则用，不可用回落 MySQL）
SEARCH_BACKEND=auto
ES_USE_FOR_BROWSE=false
